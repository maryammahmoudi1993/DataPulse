# Django
DEBUG=True
SECRET_KEY=change-me-in-production
DJANGO_SETTINGS_MODULE=datapulse.settings
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://datapulse:datapulse@localhost:5432/datapulse

# Redis
REDIS_URL=redis://localhost:6379

# Celery
CELERY_RESULT_BACKEND=django-db

# JWT
# No change needed — uses SECRET_KEY by default

# Alerts
ALERT_DEDUP_WINDOW_MINUTES=5
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_RETRIES=3

# LSTM
LSTM_MODEL_DIR=media/lstm_models

# Data export
EXPORT_ROOT=media/exports
EXPORT_TTL_HOURS=24

# Alert digest email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@datapulse.local

# Invitations
INVITE_TOKEN_TTL_DAYS=7
INVITE_BASE_URL=http://localhost:3000

# CORS (production only)
CORS_ALLOWED_ORIGINS=

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
ENVIRONMENT=development

# Cache TTLs (seconds)
STREAM_LIST_CACHE_TTL=60
ALERT_LIST_CACHE_TTL=30
STREAM_STATS_CACHE_TTL=120
